# @BotFather token. BotHost usually supplies BOT_TOKEN automatically.
BOT_TOKEN=
# Your numeric Telegram user ID. Send /id to the bot to learn it.
ADMIN_ID=
# Time zone / schedule in Moscow time.
NEWS_TZ=Europe/Moscow
NEWS_HOUR=9
NEWS_MINUTE=0
# Optional: Turn off auto-digests for testing.
AUTO_SEND=true
# Number of items. If fewer verified news are found, no filler is added.
MAX_ITEMS=28
# Optional paid AI summarization. Without a key the bot works with RSS snippets.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Persistent SQLite db for BotHost. Must survive redeploy.
DB_PATH=/app/data/dragon_news.sqlite3
